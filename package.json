{
  "name": "mini-nest",
  "version": "1.0.0",
  "description": "A hand-rolled IoC container inspired by the internals of a popular Node.js framework.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "bun --watch test/guard.test.ts",
    "test": "tsc -p test/tsconfig.json && node --experimental-test-coverage --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 --test-coverage-include='dist-test/src/**/*.js' --test 'dist-test/test/**/*.test.js'"
  },
  "dependencies": {
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^6.0.0"
  }
}
